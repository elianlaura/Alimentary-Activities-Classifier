    "version": "0.2.0",
    "configurations": [


    
    
    
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}"
        },

        {
        "name": "padts",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/run.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": { "CONDA_DEFAULT_ENV": "padts",
                "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
                "CUDA_VISIBLE_DEVICES": "0"      // use GPU #1 (or "0", or "1,3", etc.)
                },
        "args": ["-d", "drinkeats"],
        },

        {
        "name": "padts-o",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/run_ori.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": { "CONDA_DEFAULT_ENV": "padts",
                "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
                "CUDA_VISIBLE_DEVICES": "2"      // use GPU #1 (or "0", or "1,3", etc.)
                },
        "args": ["-d", "drinkeats"],
        },

        {
        "name": "pad_e",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/run.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": { "CONDA_DEFAULT_ENV": "padts",
                "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
                "CUDA_VISIBLE_DEVICES": "3"      // use GPU #1 (or "0", or "1,3", etc.)
                },
        "args": ["-d", "drinkeats"],
        },

        {
        "name": "pad_test",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/run_test.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": { "CONDA_DEFAULT_ENV": "padts",
                "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
                "CUDA_VISIBLE_DEVICES": "3"      // use GPU #1 (or "0", or "1,3", etc.)
                },
        "args": ["-d", "drink"],
        },
    ]
}